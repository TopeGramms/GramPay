# ============================================
# WhatsApp Money Assistant - Environment Variables
# ============================================
# Copy this file to .env and fill in your actual values
# IMPORTANT: Never commit .env file to git - it contains sensitive credentials

# ============================================
# WhatsApp Configuration (Baileys - No API Keys Needed!)
# ============================================
# Uses WhatsApp Web automation - completely free!
# Just run the server and scan the QR code at http://localhost:3000/qr

# Your WhatsApp account phone number (with country code)
AUTHORIZED_PHONE_NUMBER=2348073562745

# ============================================
# Groq AI API Configuration (FREE)
# ============================================
# Get free API key from https://console.groq.com/keys
# Groq is 100% FREE and very fast!
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================
# Flutterwave Payout API Configuration
# ============================================
# Create these in your Flutterwave dashboard. Use TEST keys until the beta is ready
# to send real money. Never commit real keys.
FLW_SECRET_KEY=FLWSECK_TEST-your_secret_key_here
# Set this same random value in Flutterwave Dashboard > Webhooks > Secret Hash.
FLW_WEBHOOK_SECRET=replace_with_a_long_random_secret
# Public HTTPS URL that Flutterwave calls with transfer updates.
FLW_TRANSFER_CALLBACK_URL=https://your-domain.com/api/flutterwave/webhook

# ============================================
# Supabase Configuration
# ============================================
# Get these from your Supabase project settings
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Optional: Use service role key for server-side operations
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ============================================
# Server Configuration
# ============================================
# Port to run the server on (default: 3000)
PORT=3000

# Environment (development, production)
NODE_ENV=development

# ============================================
# Optional: Additional Configuration
# ============================================
# Daily spending limit (in Naira)
# DEFAULT_DAILY_LIMIT=100000

# PIN for additional security (4 digits, optional)
# BOT_PIN=1234

# Bot active status (true/false)
# BOT_ACTIVE_STATUS=true
