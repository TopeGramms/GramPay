# Server Configuration
NODE_ENV=development
PORT=3000
ADMIN_API_KEY=your_admin_api_key_secret_here

# Supabase (Database)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Meta Cloud API (WhatsApp)
META_WHATSAPP_TOKEN=EAAG...
META_PHONE_NUMBER_ID=1234567890
META_VERIFY_TOKEN=grampay_verify_token_secret
META_APP_SECRET=your_meta_app_secret_here

# Flutterwave (Payments)
FLW_SECRET_KEY=FLWSECK_TEST-...
FLW_PUBLIC_KEY=FLWPUBK_TEST-...
FLW_WEBHOOK_SECRET=your_flutterwave_secret_hash_here

# Groq AI (LLM Command Parsing)
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile

# Financial Defaults
DEFAULT_DAILY_LIMIT=50000
